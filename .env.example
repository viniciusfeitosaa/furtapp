# Hair try-on — MediaPipe (grátis / open source)
# Não há variáveis obrigatórias. O modelo carrega via CDN oficial do MediaPipe.

# Auth + banco (portal admin/paciente)
DATABASE_URL="file:./prisma/dev.db"
# Mínimo 32 caracteres em produção
AUTH_SECRET="dev-secret-change-in-production-min-32-chars!!"

# Credenciais seed (apenas desenvolvimento — troque em produção)
SEED_ADMIN_EMAIL="admin@ffurtado.com.br"
SEED_ADMIN_PASSWORD="Admin@Furtado2026"
SEED_PATIENT_EMAIL="paciente@demo.com"
SEED_PATIENT_PASSWORD="Paciente@Demo2026"
